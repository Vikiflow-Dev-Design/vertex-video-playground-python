GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_LOCATION=global
GOOGLE_GENAI_USE_VERTEXAI=True

# MongoDB Configuration
MONGODB_URI="mongodb://username:password@host:port/?directConnection=true"
MONGODB_DB="video-studio"
MONGODB_USER_ID="your-user-id"

# Optional, if you're using a service account key locally
GOOGLE_APPLICATION_CREDENTIALS="C:\path\to\your\gcp-key.json"
